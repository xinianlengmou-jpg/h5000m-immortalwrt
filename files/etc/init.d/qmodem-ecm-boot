#!/bin/sh /etc/rc.common
# 开机兜底拨号：ECM / NCM / RNDIS 模组的网卡可能晚于 modem_scand 出现，
# 这里等网卡就绪后补一次拨号。QMI / MBIM 模式不会触发任何动作。

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/qmodem-ecm-boot
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
