#!/bin/sh
# 修 QModem 的 AT 命令通道（两处独立的问题，都出在 send_at 分支）
#
# ---------- 问题 1：AT 控制台恒定返回 status:"0"，一条命令都发不出去 ----------
# 现象：LuCI「模组管理 → AT 终端」发任何命令都显示 "No response."；
#       ubus 直接调也是 {"at_cfg":{"status":"0"}}（没有 res 字段）。
#
# 原因：AT 终端实际走的是 qmodem_cache 的任务队列：
#           JS controls.sendAt()  →  qmodem_cache.action{object:qmodem, method:send_at, args}
#           →  /usr/bin/qmodem-task  →  ubus call qmodem send_at "$args"
#       而前端塞进 args 的是扁平的 {"at":"ATI","port":"/dev/ttyUSB2"}，
#       既没有 config_section，也没有 params 包裹。
#       后端 send_at 读的是 @.params —— 取不到 → cmd/port 全空 →
#       at "" "" 执行失败 → status="0"。
#       直接 ubus call qmodem send_at '{"config_section":"2_1","params":{...}}' 却完全正常。
#
# 处理：进入 send_at 分支时，如果 input 里没有 "params" 这个键，就补一层
#       {"params": <原 input>}。这样扁平参数也能解析，两种调用方式都能用。
#
# ---------- 问题 2：串口竞争，AT 命令时通时断 ----------
# 原因：send_at 读 params.use_ubus_flag，前端发的键名是 use_ubus —— 对不上，
#       use_ubus_flag 永远为空，tom_modem 不带 -u 直接开串口，和 ubus-at-daemon 抢
#       同一个 /dev/ttyUSBx，谁抢到谁赢（实测裸跑失败率约 1/3）。
#
# 处理：取不到 use_ubus_flag 时回落到 UCI 的 use_ubus（值为 1），
#       tom_modem 就会带 -u 走 daemon 串行化；UCI 也读不到时按 1 处理。
#
# ---------- 注意：别在 /usr/libexec/rpcd/ 下留备份 ----------
# rpcd 会把该目录下每个文件都当插件加载。之前把备份写成 qmodem.bak，
# 结果 rpcd 多注册了一个 "qmodem.bak" 对象，真正的 "qmodem" 对象反而注册失败
# → 所有 QModem 页面全部失联。备份改放 /root。
#
# 幂等：打过补丁（含 qmodem-at-args 标记）就跳过。

F=/usr/libexec/rpcd/qmodem

[ -f "$F" ] || exit 0
grep -q 'send_at)' "$F" || exit 0
grep -q 'qmodem-at-args' "$F" && exit 0

cp "$F" /root/rpcd-qmodem.orig 2>/dev/null

awk -v Q="'" '
	{ print }

	!d1 && $0 ~ /^[[:space:]]*send_at\)[[:space:]]*$/ {
		print "                # [qmodem-at-args] 任务队列传来的参数是扁平的（无 params 包裹），补一层"
		print "                case \"$input\" in *" Q "\"params\"" Q "*) ;; *) input=$(printf " Q "{\"params\":%s}" Q " \"$input\");; esac"
		d1 = 1
	}

	!d2 && index($0, "jq -r " Q ".use_ubus_flag" Q) > 0 {
		print "                case \"$use_ubus_flag\" in 1|true) ;; *) use_ubus_flag=$(uci -q get qmodem.\"$config_section\".use_ubus 2>/dev/null); [ -n \"$use_ubus_flag\" ] || use_ubus_flag=1;; esac"
		d2 = 1
	}
' "$F" >"$F.new" || exit 1

[ -s "$F.new" ] || exit 1
grep -q 'qmodem-at-args' "$F.new" || exit 1
grep -q 'use_ubus_flag=1' "$F.new" || exit 1
mv "$F.new" "$F"
chmod 755 "$F"

logger -t qmodem-at-ubus "已修补 rpcd/qmodem 的 send_at：params 兜底 + use_ubus 缺省为 1"

exit 0
