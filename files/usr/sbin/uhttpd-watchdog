#!/bin/sh
# uhttpd 看门狗 —— 兜住「LuCI 后台打不开，但 SSH / 拨号一切正常」这种情况
#
# 现象：procd 里 uhttpd 实例的 incarnation 飙到几十次，最后日志只剩一句
#     daemon.warn procd: failed to remove busy cgroup of uhttpd::instance1
# 之后 uhttpd 就再也不起来了 —— 80/443 无监听，浏览器打不开后台，
# 而 rpcd / dropbear / 拨号全都正常，很容易误判成网络或浏览器问题。
#
# 原因：uhttpd 在开机阶段（网卡、IPv6、WiFi 还在陆续起来）反复退出，
# procd 的 respawn 默认只有 5 次/小时（threshold=3600 retry=5），
# 额度用尽后就彻底放弃，且此时清理 cgroup 失败，服务停在 inactive。
#
# 处理：本脚本每 30 秒确认一次 80/443 是否在监听，不在就重新拉起 uhttpd。
# 尊重用户选择：uhttpd 没设开机自启（enabled=no）时完全不干预。

INTERVAL="${UHTTPD_WATCHDOG_INTERVAL:-30}"

[ -x /etc/init.d/uhttpd ] || exit 0

listening() {
	netstat -ltn 2>/dev/null | grep -qE ':(80|443)([[:space:]]|$)' && return 0
	ss -ltn 2>/dev/null | grep -qE ':(80|443)([[:space:]]|$)' && return 0
	return 1
}

while :; do
	if /etc/init.d/uhttpd enabled >/dev/null 2>&1; then
		if ! listening; then
			logger -t uhttpd-watchdog "80/443 无监听，重新拉起 uhttpd"
			/etc/init.d/uhttpd restart >/dev/null 2>&1
		fi
	fi
	sleep "$INTERVAL"
done
